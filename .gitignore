# Data / model artifacts (regenerated by the ETL + training scripts, not committed)
*.db
*.sqlite
*.sqlite3
# data/cache/ (no leading slash, but with a slash in the middle) is anchored
# to the repo root in gitignore syntax -- it silently did NOT match
# backend/data/cache/. Use backend/data/ explicitly instead of trusting an
# unanchored pattern to catch every ETL cache dir this project might add.
backend/data/
fastf1_cache/
*.pkl
*.joblib

# Environment / secrets
.env

# OS / editor
.DS_Store
Thumbs.db

# Claude Code ephemeral state
.claude/scheduled_tasks.lock
